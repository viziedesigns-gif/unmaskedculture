<body>
  <div id="site-nav-root"></div>
  <main>
    <section class="contact-hero" aria-labelledby="contact-title">
      <div class="hero-inner">
        <p class="eyebrow">Connect with us</p>
        <h1 id="contact-title">Let’s talk about what matters.</h1>
        <p>Questions, ideas, stories, and partnership opportunities all have a place here. Reach out and a member of our team will be in touch.</p>
      </div>
    </section>
    <section class="contact-section">
      <div class="contact-inner">
        <aside class="contact-aside">
          <div>
            <p class="eyebrow">Unmasked Culture Foundation</p>
            <h2>You do not have to navigate it alone.</h2>
            <p>Whether you need a resource, want to collaborate, or simply have something to share, we are ready to listen.</p>
            <div class="contact-details">
              <div class="contact-detail"><span>Explore</span><a href="/podcast">Listen to the podcast →</a></div>
              <div class="contact-detail"><span>Read</span><a href="/blogs">Visit the community blog →</a></div>
              <div class="contact-detail"><span>Get involved</span><a href="/volunteer">Volunteer with us →</a></div>
            </div>
          </div>
          <p class="aside-note">This form is for general inquiries and is not monitored as a crisis service. If you are in immediate danger, contact local emergency services.</p>
        </aside>
        <section class="form-card" aria-labelledby="form-title">
          <h2 id="form-title">Send us a message</h2>
          <p class="form-intro">Tell us how we can help. Required fields are marked with an asterisk.</p>
          <div class="error-banner" id="form-error" role="alert" hidden></div>
          <form action="/api/submit-contact.php" method="post">
            <div class="website-field" aria-hidden="true"><label for="website">Website</label><input id="website" name="website" type="text" tabindex="-1" autocomplete="off"></div>
            <div class="field-grid">
              <div class="field"><label for="first-name">First name <span aria-hidden="true">*</span></label><input id="first-name" name="first_name" type="text" autocomplete="given-name" maxlength="100" required></div>
              <div class="field"><label for="last-name">Last name <span aria-hidden="true">*</span></label><input id="last-name" name="last_name" type="text" autocomplete="family-name" maxlength="100" required></div>
              <div class="field"><label for="email">Email <span aria-hidden="true">*</span></label><input id="email" name="email" type="email" autocomplete="email" maxlength="254" required></div>
              <div class="field"><label for="phone">Phone</label><input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="40"><small>Optional. Your number will be included securely with your message.</small></div>
              <div class="field"><label for="preferred-contact">Preferred communication method <span aria-hidden="true">*</span></label><select id="preferred-contact" name="preferred_contact" required><option value="">Please choose one</option><option value="Phone">Phone</option><option value="Email">Email</option></select></div>
              <div class="field"><label for="best-time">Best time to contact you <span aria-hidden="true">*</span></label><select id="best-time" name="best_time" required><option value="">Please choose one</option><option value="Morning">Morning</option><option value="Afternoon">Afternoon</option><option value="Evening">Evening</option></select></div>
              <div class="field full"><label for="message">Message <span aria-hidden="true">*</span></label><textarea id="message" name="message" maxlength="5000" required></textarea><small>Please do not include private medical or financial information.</small></div>
            </div>
            <div class="consent"><input id="consent" name="consent" type="checkbox" value="1" required><label for="consent">By completing this form, you agree to receive communications from Unmasked Culture Foundation.</label></div>
            <button class="submit-button" type="submit">Send message <span aria-hidden="true">→</span></button>
            <p class="privacy-note">Your message is submitted securely through Formcan and used only to respond to your inquiry.</p>
          </form>
        </section>
      </div>
    </section>
  </main>
  <footer class="uc-footer">
    <div class="footer-inner"><div class="footer-grid">
      <div><a class="footer-brand" href="/"><span class="red">UNMASKED</span> <span class="white">CULTURE</span></a><p class="footer-about">Creating honest spaces for mental health, faith, healing, and community.</p></div>
      <div class="footer-column"><h3>Explore</h3><a href="/about">About</a><a href="/team">Our team</a><a href="/contact">Contact</a></div>
      <div class="footer-column"><h3>Resources</h3><a href="/podcast">Podcast</a><a href="/blogs">Blogs</a><a href="/help">Find help</a></div>
      <div class="footer-column"><h3>Get involved</h3><a href="/volunteer">Volunteer</a><a href="/donate">Donate</a><a href="/kinto">Kinto</a></div>
    </div><div class="footer-bottom">© 2026 Unmasked Culture Foundation. All rights reserved.</div></div>
  </footer>
