  <script>
    document.getElementById('yc').textContent = new Date().getFullYear();

    (function () {
      var staggered = document.querySelectorAll('.dn-panel, .dn-impact article, .dn-recog article, .dn-quote, .dn-faq details');
      staggered.forEach(function (node, index) {
        node.classList.add('vc-reveal');
        node.style.transitionDelay = ((index % 4) * 70) + 'ms';
      });
      var nodes = document.querySelectorAll('.vc-reveal');
      if (!nodes.length) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        nodes.forEach(function (n) { n.classList.add('is-in'); });
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.16, rootMargin: '0px 0px -8% 0px' });
      nodes.forEach(function (n) { io.observe(n); });

      var progress = document.querySelector('.dn-scroll-progress');
      var heroImage = document.querySelector('.dn-hero__bg img');
      var ticking = false;
      function updateScrollMotion() {
        var scrollable = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
        if (progress) progress.style.transform = 'scaleX(' + Math.min(window.scrollY / scrollable, 1) + ')';
        if (heroImage) heroImage.style.transform = 'translate3d(0,' + Math.min(window.scrollY * 0.06, 38) + 'px,0) scale(1.035)';
        ticking = false;
      }
      window.addEventListener('scroll', function () {
        if (!ticking) { window.requestAnimationFrame(updateScrollMotion); ticking = true; }
      }, { passive: true });
      updateScrollMotion();
    })();
  </script>
