  <script>
    (function() {
      const params = new URLSearchParams(window.location.search);
      const alertBox = document.getElementById('login-alert');
      const messages = {
        missing: 'Enter both your email address and password.',
        invalid: 'The email address or password was not recognized. Please try again.',
        required: 'Sign in to continue to that part of Kinto.',
        expired: 'Your session expired. Please sign in again.',
        security_update: 'For your security, please sign in again.',
        invite: 'That Circle invitation is invalid or has expired. Ask the Circle owner for a new link.',
        'logged-out': 'You have been signed out of Kinto.',
        'account-deleted': 'Your Kinto account and associated data have been deleted.'
      };
      const statusKey = params.get('status');
      const messageKey = params.get('login') || params.get('session') || params.get('notice') || statusKey;
      if (alertBox && messages[messageKey]) {
        alertBox.textContent = messages[messageKey];
        if (statusKey === 'logged-out' || statusKey === 'account-deleted') alertBox.classList.add('is-success');
        alertBox.hidden = false;
      }

      const inviteCode = params.get('invite') || '';
      const returnPath = params.get('return') || '';
      const inviteInput = document.getElementById('login-invite-code');
      const returnInput = document.getElementById('login-return');
      if (inviteInput) inviteInput.value = inviteCode;
      if (returnInput && returnPath.indexOf('/challenge/app/member_profile.php?') === 0) returnInput.value = returnPath;

      const loginForm = document.getElementById('kinto-login-form');
      if (loginForm && (inviteCode || returnPath.indexOf('/challenge/app/member_profile.php?') === 0)) {
        const actionParams = new URLSearchParams();
        if (inviteCode) actionParams.set('invite', inviteCode);
        if (returnPath.indexOf('/challenge/app/member_profile.php?') === 0) actionParams.set('return', returnPath);
        loginForm.action = '/challenge/app/?' + actionParams.toString();
      }

      const createLink = document.getElementById('create-account-link');
      if (createLink && (inviteCode || returnPath)) {
        const createParams = new URLSearchParams();
        if (inviteCode) createParams.set('invite', inviteCode);
        if (returnPath) createParams.set('return', returnPath);
        createLink.href += '?' + createParams.toString();
      }

      if (messageKey || inviteCode || params.get('signin') === '1') {
        window.requestAnimationFrame(function() {
          document.getElementById('signin')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
      }
    })();

    (function() {
      const menuToggle = document.getElementById('mobile-menu');
      const __legacyNavMenu = document.getElementById('nav-menu');
      if (!menuToggle || !__legacyNavMenu) return; // shared site-nav
      const navMenu = document.getElementById('nav-menu');

      if (!menuToggle || !navMenu) {
        return;
      }

      menuToggle.addEventListener('click', function() {
        navMenu.classList.toggle('active');
        document.body.style.overflow = navMenu.classList.contains('active') ? 'hidden' : '';
      });

      window.addEventListener('resize', function() {
        if (window.innerWidth > 1040 && navMenu.classList.contains('active')) {
          navMenu.classList.remove('active');
          document.body.style.overflow = '';
        }
      });
    })();
  </script>
