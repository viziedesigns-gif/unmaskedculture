  <style>
    :root {
      --ink: #201f1c;
      --ink-soft: #58554e;
      --cream: #f5f0e8;
      --cream-deep: #e9dfd0;
      --paper: #fffdf9;
      --gold: #bd8c2f;
      --gold-soft: #d8b66c;
      --sage: #708474;
      --line: rgba(42, 38, 30, 0.13);
      --black: #0c0d0c;
      --white: #ffffff;
      --shadow: 0 24px 70px rgba(45, 38, 24, 0.11);
    }

    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      color: var(--ink);
      background: var(--cream);
      font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      line-height: 1.75;
    }
    a { color: inherit; }
    img { max-width: 100%; }

    .privacy-hero {
      position: relative;
      min-height: 490px;
      display: grid;
      align-items: center;
      overflow: hidden;
      background:
        radial-gradient(circle at 78% 28%, rgba(216, 182, 108, 0.22), transparent 23%),
        linear-gradient(125deg, #151714 0%, #20211d 56%, #121310 100%);
      color: var(--white);
    }
    .privacy-hero::before,
    .privacy-hero::after {
      content: "";
      position: absolute;
      pointer-events: none;
    }
    .privacy-hero::before {
      width: 720px;
      height: 340px;
      right: -180px;
      top: -120px;
      border: 2px solid rgba(216, 182, 108, 0.48);
      border-radius: 50%;
      transform: rotate(-14deg);
    }
    .privacy-hero::after {
      inset: auto 0 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--gold), transparent);
    }
    .hero-inner {
      width: min(1180px, calc(100% - 40px));
      margin: 0 auto;
      padding: 72px 0;
      display: grid;
      grid-template-columns: minmax(0, 1fr) 260px;
      align-items: center;
      gap: 70px;
      position: relative;
      z-index: 1;
    }
    .eyebrow {
      margin: 0 0 18px;
      color: var(--gold-soft);
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }
    .privacy-hero h1 {
      margin: 0;
      font-family: "DM Serif Display", Georgia, serif;
      font-size: clamp(3.2rem, 8vw, 6.7rem);
      font-weight: 400;
      line-height: 0.95;
      letter-spacing: -0.03em;
    }
    .hero-lead {
      max-width: 710px;
      margin: 24px 0 0;
      color: rgba(255,255,255,0.72);
      font-size: clamp(1rem, 2vw, 1.18rem);
    }
    .hero-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 22px;
      margin-top: 28px;
      color: rgba(255,255,255,0.58);
      font-size: 0.87rem;
    }
    .hero-mark {
      position: relative;
      padding: 18px;
      border: 1px solid rgba(255,255,255,0.13);
      border-radius: 42% 42% 44% 44%;
      background: rgba(255,255,255,0.05);
      box-shadow: 0 28px 80px rgba(0,0,0,0.35);
    }
    .hero-mark img {
      display: block;
      width: 100%;
      border-radius: 30%;
    }

    .policy-shell {
      width: min(1180px, calc(100% - 40px));
      margin: 0 auto;
      padding: 72px 0 96px;
      display: grid;
      grid-template-columns: 250px minmax(0, 1fr);
      gap: 58px;
      align-items: start;
    }
    .policy-nav {
      position: sticky;
      top: 110px;
      padding: 25px;
      background: rgba(255,253,249,0.75);
      border: 1px solid var(--line);
      border-radius: 18px;
      backdrop-filter: blur(12px);
    }
    .policy-nav strong {
      display: block;
      margin-bottom: 13px;
      font-size: 0.78rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .policy-nav a {
      display: block;
      padding: 7px 0;
      color: var(--ink-soft);
      font-size: 0.9rem;
      text-decoration: none;
    }
    .policy-nav a:hover { color: var(--gold); }
    .policy-nav .back-link {
      margin-top: 18px;
      padding-top: 18px;
      border-top: 1px solid var(--line);
      color: var(--ink);
      font-weight: 700;
    }

    .policy-content {
      padding: clamp(28px, 5vw, 64px);
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: 24px;
      box-shadow: var(--shadow);
    }
    .summary-card {
      margin-bottom: 48px;
      padding: 28px;
      border-left: 4px solid var(--gold);
      border-radius: 0 14px 14px 0;
      background: linear-gradient(110deg, rgba(216,182,108,0.14), rgba(112,132,116,0.08));
    }
    .summary-card h2 {
      margin-top: 0;
      font-size: 1.15rem;
    }
    .summary-card p:last-child { margin-bottom: 0; }
    .policy-section {
      scroll-margin-top: 110px;
      padding: 44px 0;
      border-top: 1px solid var(--line);
    }
    .policy-section:first-of-type { border-top: 0; }
    .section-number {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      margin-bottom: 12px;
      border: 1px solid rgba(189,140,47,0.42);
      border-radius: 50%;
      color: var(--gold);
      font-size: 0.78rem;
      font-weight: 800;
    }
    .policy-section h2 {
      margin: 0 0 18px;
      font-family: "DM Serif Display", Georgia, serif;
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 400;
      line-height: 1.08;
    }
    .policy-section h3 {
      margin: 28px 0 8px;
      font-size: 1rem;
    }
    .policy-section p { color: var(--ink-soft); }
    .policy-section ul {
      margin: 16px 0 0;
      padding-left: 1.25rem;
      color: var(--ink-soft);
    }
    .policy-section li { margin: 10px 0; padding-left: 5px; }
    .policy-section strong { color: var(--ink); }
    .data-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
      margin-top: 24px;
    }
    .data-card {
      padding: 22px;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: #fff;
    }
    .data-card h3 { margin: 0 0 7px; }
    .data-card p { margin: 0; font-size: 0.94rem; }
    .contact-card {
      margin-top: 24px;
      padding: 26px;
      border-radius: 16px;
      background: var(--black);
      color: var(--white);
    }
    .contact-card p { margin: 5px 0; color: rgba(255,255,255,0.7); }
    .contact-card a { color: var(--gold-soft); }

    .site-footer {
      padding: 58px 24px 30px;
      background: #000;
      color: #fff;
    }
    .footer-inner { width: min(1180px, 100%); margin: 0 auto; }
    .footer-top {
      display: flex;
      justify-content: space-between;
      gap: 40px;
      align-items: flex-start;
    }
    .footer-brand {
      font-weight: 800;
      letter-spacing: 0.04em;
      text-decoration: none;
    }
    .footer-brand span:first-child { color: #ff0000; }
    .footer-copy { max-width: 460px; margin: 14px 0 0; color: rgba(255,255,255,0.6); }
    .footer-actions { display: flex; flex-wrap: wrap; gap: 12px 22px; }
    .footer-actions a { color: rgba(255,255,255,0.75); text-decoration: none; }
    .footer-actions a:hover { color: #fff; }
    .footer-bottom {
      margin-top: 42px;
      padding-top: 22px;
      border-top: 1px solid rgba(255,255,255,0.12);
      color: rgba(255,255,255,0.48);
      font-size: 0.88rem;
    }

    @media (max-width: 860px) {
      .hero-inner { grid-template-columns: 1fr; gap: 35px; }
      .hero-mark { width: 180px; }
      .policy-shell { grid-template-columns: 1fr; }
      .policy-nav { position: static; }
      .policy-nav a:not(.back-link) { display: none; }
      .policy-nav strong { margin: 0; }
      .policy-nav .back-link { display: inline-block; margin-top: 12px; }
      .data-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 620px) {
      .privacy-hero { min-height: 0; }
      .hero-inner, .policy-shell { width: min(100% - 28px, 1180px); }
      .hero-inner { padding: 52px 0; }
      .hero-mark { width: 140px; }
      .policy-shell { padding: 40px 0 64px; gap: 22px; }
      .policy-content { border-radius: 18px; }
      .footer-top { flex-direction: column; }
    }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  </style>
</head>
