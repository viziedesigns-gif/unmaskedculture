  <!-- Scripts -->
  <script>
    (function() {
      'use strict';
      
      // Mobile menu
      const menuToggle = document.getElementById('mobile-menu');
      const __legacyNavMenu = document.getElementById('nav-menu');
      if (!menuToggle || !__legacyNavMenu) return; // shared site-nav
      const navMenu = document.getElementById('nav-menu');
      
      const dropdowns = Array.from(document.querySelectorAll('.dropdown'));

      function setDropdownState(dropdown, isOpen) {
        dropdown.classList.toggle('active', isOpen);
        dropdown.querySelector('.dropdown-toggle').setAttribute('aria-expanded', String(isOpen));
      }

      function closeDropdowns(except) {
        dropdowns.forEach(dropdown => {
          if (dropdown !== except) setDropdownState(dropdown, false);
        });
      }

      function setMenuState(isOpen, returnFocus) {
        menuToggle.classList.toggle('active', isOpen);
        navMenu.classList.toggle('active', isOpen);
        menuToggle.setAttribute('aria-expanded', String(isOpen));
        menuToggle.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu');
        document.body.style.overflow = isOpen ? 'hidden' : '';
        if (!isOpen) closeDropdowns();
        if (returnFocus) menuToggle.focus();
      }

      menuToggle.addEventListener('click', function() {
        setMenuState(!navMenu.classList.contains('active'));
      });

      document.querySelectorAll('.dropdown-toggle').forEach(toggle => {
        toggle.addEventListener('click', function(e) {
          if (window.innerWidth <= 960) {
            e.preventDefault();
            e.stopPropagation();
            const dropdown = toggle.closest('.dropdown');
            const willOpen = !dropdown.classList.contains('active');
            closeDropdowns(dropdown);
            setDropdownState(dropdown, willOpen);
          }
        });
      });
      
      document.addEventListener('click', function(e) {
        if (window.innerWidth <= 960 && navMenu.classList.contains('active') &&
            !navMenu.contains(e.target) && !menuToggle.contains(e.target)) {
          setMenuState(false);
        }
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          if (navMenu.classList.contains('active')) setMenuState(false, true);
          else closeDropdowns();
        }
      });
      
      window.addEventListener('resize', function() {
        if (window.innerWidth > 960) setMenuState(false);
      });

      // Video background handling
      const video = document.querySelector('.video-background');
      const heroSection = document.querySelector('.hero-section');
      
      if (video && heroSection) {
        video.load();
        
        const fallbackBg = 'linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)), url("https://images.unsplash.com/photo-1517048676732-d65bc937f952?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80")';
        
        setTimeout(function() {
          if (video.readyState === 0 || video.networkState === 3) {
            heroSection.style.backgroundImage = fallbackBg;
            heroSection.style.backgroundSize = 'cover';
            heroSection.style.backgroundPosition = 'center';
            video.style.display = 'none';
          }
        }, 3000);
        
        video.addEventListener('canplaythrough', function() {
          video.play().catch(function() {
            heroSection.style.backgroundImage = fallbackBg;
            heroSection.style.backgroundSize = 'cover';
            heroSection.style.backgroundPosition = 'center';
          });
        });
        
        video.addEventListener('error', function() {
          heroSection.style.backgroundImage = fallbackBg;
          heroSection.style.backgroundSize = 'cover';
          heroSection.style.backgroundPosition = 'center';
          video.style.display = 'none';
        });
      }
      
    })();
  </script>
</body>
